# Chave de API da Anthropic/Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Conta Gmail que envia os alertas (precisa de senha de app, não a senha normal)
# Gerar em: https://myaccount.google.com/apppasswords
EMAIL_REMETENTE=
EMAIL_SENHA_APP=

# E-mail que recebe os alertas
EMAIL_DESTINATARIO=

# CPM (custo por mil pontos, em R$) considerado o teto para disparar alerta
CPM_MAXIMO_ALERTA=20.0

# URLs dos feeds RSS, separadas por vírgula
RSS_FEEDS=https://passageirodeprimeira.com/feed/,https://www.melhoresdestinos.com.br/feed,https://pontospravoar.com/feed/

# Caminho do banco SQLite local
DATABASE_PATH=milhas_monitor.db
